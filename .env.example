# These three values are public browser identifiers, not private credentials.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# Static-only news collector by default. No database or webhook writes.
NEWS_WRITE_SUPABASE=false
NEWS_DISCORD_NOTIFY=false
NEWS_MAX_ITEMS=60
NEWS_MAX_AGE_HOURS=72
# Optional comma-separated publisher adapters already supported by the collector.
NEWS_SOURCES_ALLOWLIST=
# Never prefix a private service-role key with VITE_.
